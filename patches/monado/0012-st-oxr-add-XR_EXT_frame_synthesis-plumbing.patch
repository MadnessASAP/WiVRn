+static xrt_result_t
+_update_frame_synthesis(struct xrt_compositor *xc,
+                        volatile struct ipc_client_state *ics,
+                        volatile struct ipc_layer_entry *layer,
+                        uint32_t i)
+{
+	if (!layer->has_frame_synthesis) {
+		return XRT_SUCCESS;
+	}
+
+	// Copy out of shared memory before validating.
+	struct xrt_layer_frame_synthesis_data fs = *(struct xrt_layer_frame_synthesis_data *)&layer->fs;
