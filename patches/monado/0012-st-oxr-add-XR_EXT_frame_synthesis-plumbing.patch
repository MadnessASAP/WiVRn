+	if (fs.view_count != layer->data.view_count || fs.view_count > XRT_MAX_VIEWS) {
+		U_LOG_E("Invalid view count for frame synthesis data of layer #%u!", i);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	struct xrt_swapchain *mv_xcs[XRT_MAX_VIEWS] = {0};
+	struct xrt_swapchain *d_xcs[XRT_MAX_VIEWS] = {0};
+
+	for (uint32_t j = 0; j < fs.view_count; j++) {
+		const uint32_t mv_xsci = layer->swapchain_ids[2 * XRT_MAX_VIEWS + j];
+		const uint32_t d_xsci = layer->swapchain_ids[3 * XRT_MAX_VIEWS + j];
+
+		if (mv_xsci >= IPC_MAX_CLIENT_SWAPCHAINS || d_xsci >= IPC_MAX_CLIENT_SWAPCHAINS) {
+			U_LOG_E("Invalid frame synthesis swapchain index for layer #%u!", i);
+			return XRT_ERROR_IPC_FAILURE;
+		}
+
+		mv_xcs[j] = ics->xscs[mv_xsci];
+		d_xcs[j] = ics->xscs[d_xsci];
+		if (mv_xcs[j] == NULL || d_xcs[j] == NULL) {
+			U_LOG_E("Invalid frame synthesis swapchain for layer #%u!", i);
+			return XRT_ERROR_IPC_FAILURE;
+		}
+	}
+
+	xrt_result_t xret = xrt_comp_layer_frame_synthesis(xc, mv_xcs, d_xcs, &fs);
+	if (xret == XRT_ERROR_NOT_IMPLEMENTED) {
+		// Frame synthesis data is optional, drop it.
+		return XRT_SUCCESS;
+	}
+	return xret;
