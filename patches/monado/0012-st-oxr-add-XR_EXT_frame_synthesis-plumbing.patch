+#ifdef OXR_HAVE_EXT_frame_synthesis
+static XrResult
+verify_frame_synthesis_sub_image(struct oxr_logger *log,
+                                 uint32_t layer_index,
+                                 uint32_t i,
+                                 const char *member,
+                                 const XrSwapchainSubImage *sub)
+{
+	if (sub->swapchain == XR_NULL_HANDLE) {
+		return oxr_error(log, XR_ERROR_HANDLE_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.%s.swapchain) is "
+		                 "XR_NULL_HANDLE",
+		                 layer_index, i, member);
+	}
+
+	struct oxr_swapchain *sc = XRT_CAST_OXR_HANDLE_TO_PTR(struct oxr_swapchain *, sub->swapchain);
+
+	if (!sc->released.yes) {
+		return oxr_error(log, XR_ERROR_LAYER_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.%s.swapchain) "
+		                 "swapchain has not been released",
+		                 layer_index, i, member);
+	}
+
+	if (sc->released.index >= (int)sc->swapchain->image_count) {
+		return oxr_error(log, XR_ERROR_RUNTIME_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.%s.swapchain) "
+		                 "internal image index out of bounds",
+		                 layer_index, i, member);
+	}
+
+	if (sc->array_layer_count <= sub->imageArrayIndex) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.%s.imageArrayIndex "
+		                 "== %u) Invalid swapchain array index (%u).",
+		                 layer_index, i, member, sub->imageArrayIndex, sc->array_layer_count);
+	}
+
+	if (sc->face_count != 1) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.%s.swapchain) "
+		                 "Invalid swapchain face count (expected 1, got %u)",
+		                 layer_index, i, member, sc->face_count);
+	}
+
+	if (is_rect_neg(&sub->imageRect)) {
+		return oxr_error(log, XR_ERROR_SWAPCHAIN_RECT_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.%s.imageRect."
+		                 "offset == {%i, %i}) has negative component(s)",
+		                 layer_index, i, member, sub->imageRect.offset.x, sub->imageRect.offset.y);
+	}
+
+	if (is_rect_out_of_bounds(&sub->imageRect, sc)) {
+		return oxr_error(log, XR_ERROR_SWAPCHAIN_RECT_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.%s.imageRect == "
+		                 "{{%i, %i}, {%u, %u}}) imageRect out of image bounds (%u, %u)",
+		                 layer_index, i, member, sub->imageRect.offset.x, sub->imageRect.offset.y,
+		                 sub->imageRect.extent.width, sub->imageRect.extent.height, sc->width, sc->height);
+	}
+
+	return XR_SUCCESS;
+}
