+static XrResult
+verify_frame_synthesis(struct oxr_logger *log,
+                       uint32_t layer_index,
+                       uint32_t i,
+                       const XrFrameSynthesisInfoEXT *fs)
+{
+	const XrFrameSynthesisInfoFlagsEXT valid_flags = XR_FRAME_SYNTHESIS_INFO_USE_2D_MOTION_VECTOR_BIT_EXT |
+	                                                 XR_FRAME_SYNTHESIS_INFO_REQUEST_RELAXED_FRAME_INTERVAL_BIT_EXT;
+	if ((fs->layerFlags & ~valid_flags) != 0) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.layerFlags == "
+		                 "0x%" PRIx64 ") contains invalid bits",
+		                 layer_index, i, fs->layerFlags);
+	}
+
+	XrResult ret = verify_frame_synthesis_sub_image(log, layer_index, i, "motionVectorSubImage",
+	                                                &fs->motionVectorSubImage);
+	if (ret != XR_SUCCESS) {
+		return ret;
+	}
+
+	ret = verify_frame_synthesis_sub_image(log, layer_index, i, "depthSubImage", &fs->depthSubImage);
+	if (ret != XR_SUCCESS) {
+		return ret;
+	}
+
+	if (!math_quat_validate_within_1_percent((struct xrt_quat *)&fs->appSpaceDeltaPose.orientation)) {
+		const XrQuaternionf *q = &fs->appSpaceDeltaPose.orientation;
+		return oxr_error(log, XR_ERROR_POSE_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.appSpaceDeltaPose."
+		                 "orientation == {%f %f %f %f}) is not a valid quat",
+		                 layer_index, i, q->x, q->y, q->z, q->w);
+	}
+
+	if (!math_vec3_validate((struct xrt_vec3 *)&fs->appSpaceDeltaPose.position)) {
+		const XrVector3f *p = &fs->appSpaceDeltaPose.position;
+		return oxr_error(log, XR_ERROR_POSE_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.appSpaceDeltaPose."
+		                 "position == {%f %f %f}) is not valid",
+		                 layer_index, i, p->x, p->y, p->z);
+	}
+
+	if (!(fs->minDepth >= 0.0f && fs->minDepth <= 1.0f)) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.minDepth) %f must "
+		                 "be in [0.0,1.0]",
+		                 layer_index, i, fs->minDepth);
+	}
+
+	if (!(fs->maxDepth >= 0.0f && fs->maxDepth <= 1.0f)) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.maxDepth) %f must "
+		                 "be in [0.0,1.0]",
+		                 layer_index, i, fs->maxDepth);
+	}
+
+	if (fs->minDepth > fs->maxDepth) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.minDepth) %f must "
+		                 "be <= maxDepth %f",
+		                 layer_index, i, fs->minDepth, fs->maxDepth);
+	}
+
+	// Infinity is allowed, NaN and non-positive values are not.
+	if (!(fs->nearZ > 0.0f) || !(fs->farZ > 0.0f)) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.nearZ/farZ) %f/%f "
+		                 "must be positive distances",
+		                 layer_index, i, fs->nearZ, fs->farZ);
+	}
+
+	if (fs->nearZ == fs->farZ) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%i]->next<XrFrameSynthesisInfoEXT>.nearZ) %f must be "
+		                 "!= farZ %f",
+		                 layer_index, i, fs->nearZ, fs->farZ);
+	}
+
+	return XR_SUCCESS;
+}
