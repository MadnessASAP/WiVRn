+ * the struct. Frame synthesis data is a hint, so failures are not fatal.
+ */
+static void
+submit_frame_synthesis(struct oxr_session *sess,
+                       struct xrt_compositor *xc,
+                       struct oxr_logger *log,
+                       const XrCompositionLayerProjection *proj,
+                       struct oxr_space *spc,
+                       uint64_t oxr_timestamp)
+{
+	struct xrt_layer_frame_synthesis_data fs;
+	U_ZERO(&fs);
+	struct xrt_swapchain *mv_swapchains[XRT_MAX_VIEWS] = {0};
+	struct xrt_swapchain *d_swapchains[XRT_MAX_VIEWS] = {0};
+
+	// Pose of the layer space, in the same space as the view poses.
+	const struct xrt_pose identity = XRT_POSE_IDENTITY;
+	struct xrt_pose layer_space_pose;
+	if (!handle_space(log, sess, spc, &identity, oxr_timestamp, &layer_space_pose)) {
+		return;
+	}
+
+	fs.view_count = proj->viewCount;
+	for (uint32_t i = 0; i < proj->viewCount; ++i) {
+		const XrFrameSynthesisInfoEXT *fs_info = OXR_GET_INPUT_FROM_CHAIN(
+		    &proj->views[i], XR_TYPE_FRAME_SYNTHESIS_INFO_EXT, XrFrameSynthesisInfoEXT);
+		if (fs_info == NULL) {
+			return; // It's all or nothing.
+		}
+
+		struct xrt_layer_frame_synthesis_view_data *v = &fs.v[i];
+		v->flags = fs_info->layerFlags;
+
+		struct oxr_swapchain *mv_sc =
+		    XRT_CAST_OXR_HANDLE_TO_PTR(struct oxr_swapchain *, fs_info->motionVectorSubImage.swapchain);
+		fill_in_sub_image(mv_sc, &fs_info->motionVectorSubImage, &v->motion_vector_sub);
+		mv_swapchains[i] = mv_sc->swapchain;
+
+		v->motion_vector_scale.x = fs_info->motionVectorScale.x;
+		v->motion_vector_scale.y = fs_info->motionVectorScale.y;
+		v->motion_vector_scale.z = fs_info->motionVectorScale.z;
+		v->motion_vector_offset.x = fs_info->motionVectorOffset.x;
+		v->motion_vector_offset.y = fs_info->motionVectorOffset.y;
+		v->motion_vector_offset.z = fs_info->motionVectorOffset.z;
+
+		const struct xrt_pose *delta_pose = (const struct xrt_pose *)&fs_info->appSpaceDeltaPose;
+		v->app_space_delta_pose = *delta_pose;
+		if (!math_quat_validate(&v->app_space_delta_pose.orientation)) {
+			math_quat_normalize(&v->app_space_delta_pose.orientation);
+		}
+		v->layer_space_pose = layer_space_pose;
+
+		struct oxr_swapchain *d_sc =
+		    XRT_CAST_OXR_HANDLE_TO_PTR(struct oxr_swapchain *, fs_info->depthSubImage.swapchain);
+		fill_in_sub_image(d_sc, &fs_info->depthSubImage, &v->depth_sub);
+		d_swapchains[i] = d_sc->swapchain;
+
+		v->min_depth = fs_info->minDepth;
+		v->max_depth = fs_info->maxDepth;
+		v->near_z = fs_info->nearZ;
+		v->far_z = fs_info->farZ;
+	}
+
+	xrt_result_t xret = xrt_comp_layer_frame_synthesis(xc, mv_swapchains, d_swapchains, &fs);
+	if (xret != XRT_SUCCESS && xret != XRT_ERROR_NOT_IMPLEMENTED) {
+		oxr_warn(log, "xrt_comp_layer_frame_synthesis failed: %d, frame synthesis data dropped", xret);
+	}
+}
+#endif // OXR_HAVE_EXT_frame_synthesis
+
 static XrResult
 submit_projection_layer(struct oxr_session *sess,
                         struct xrt_compositor *xc,
@@ -1462,6 +1711,12 @@ submit_projection_layer(struct oxr_session *sess,
 		OXR_CHECK_XRET(log, sess, xret, xrt_comp_layer_projection);
 	}
 
+#ifdef OXR_HAVE_EXT_frame_synthesis
+	if (sess->sys->inst->extensions.EXT_frame_synthesis) {
+		submit_frame_synthesis(sess, xc, log, proj, spc, oxr_timestamp);
+	}
+#endif // OXR_HAVE_EXT_frame_synthesis
+
 	return XR_SUCCESS;
 }
 
