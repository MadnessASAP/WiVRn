diff --git a/src/xrt/compositor/client/comp_vk_client.c b/src/xrt/compositor/client/comp_vk_client.c
index ad3c7a6f7..08d0e67b2 100644
--- a/src/xrt/compositor/client/comp_vk_client.c
+++ b/src/xrt/compositor/client/comp_vk_client.c
@@ -515,6 +515,26 @@ client_vk_compositor_layer_stereo_projection_depth(struct xrt_compositor *xc,
 	return xrt_comp_layer_projection_depth(xcn, xdev, xscn, d_xscn, data);
 }
 
+static xrt_result_t
+client_vk_compositor_layer_frame_synthesis(struct xrt_compositor *xc,
+                                           struct xrt_swapchain *mv_xsc[XRT_MAX_VIEWS],
+                                           struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS],
+                                           const struct xrt_layer_frame_synthesis_data *data)
+{
+	struct xrt_compositor *xcn;
+
+	struct xrt_swapchain *mv_xscn[XRT_MAX_VIEWS];
+	struct xrt_swapchain *d_xscn[XRT_MAX_VIEWS];
+
+	xcn = to_native_compositor(xc);
+	for (uint32_t i = 0; i < data->view_count; ++i) {
+		mv_xscn[i] = to_native_swapchain(mv_xsc[i]);
+		d_xscn[i] = to_native_swapchain(d_xsc[i]);
+	}
+
+	return xrt_comp_layer_frame_synthesis(xcn, mv_xscn, d_xscn, data);
+}
+
 static xrt_result_t
 client_vk_compositor_layer_quad(struct xrt_compositor *xc,
                                 struct xrt_device *xdev,
@@ -844,6 +864,7 @@ client_vk_compositor_create(struct xrt_compositor_native *xcn,
 	c->base.layer_begin = client_vk_compositor_layer_begin;
 	c->base.layer_projection = client_vk_compositor_layer_projection;
 	c->base.layer_projection_depth = client_vk_compositor_layer_stereo_projection_depth;
+	c->base.layer_frame_synthesis = client_vk_compositor_layer_frame_synthesis;
 	c->base.layer_quad = client_vk_compositor_layer_quad;
 	c->base.layer_cube = client_vk_compositor_layer_cube;
 	c->base.layer_cylinder = client_vk_compositor_layer_cylinder;
diff --git a/src/xrt/compositor/multi/comp_multi_compositor.c b/src/xrt/compositor/multi/comp_multi_compositor.c
index 0dcf90ca6..bcfbe42cb 100644
--- a/src/xrt/compositor/multi/comp_multi_compositor.c
+++ b/src/xrt/compositor/multi/comp_multi_compositor.c
@@ -709,6 +709,34 @@ multi_compositor_layer_projection_depth(struct xrt_compositor *xc,
 	return XRT_SUCCESS;
 }
 
+static xrt_result_t
+multi_compositor_layer_frame_synthesis(struct xrt_compositor *xc,
+                                       struct xrt_swapchain *mv_xsc[XRT_MAX_VIEWS],
+                                       struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS],
+                                       const struct xrt_layer_frame_synthesis_data *data)
+{
+	struct multi_compositor *mc = multi_compositor(xc);
+
+	if (mc->progress.layer_count == 0 || data->view_count > XRT_MAX_VIEWS) {
+		return XRT_ERROR_INVALID_ARGUMENT;
+	}
+
+	struct multi_layer_entry *layer = &mc->progress.layers[mc->progress.layer_count - 1];
+	if ((layer->data.type != XRT_LAYER_PROJECTION && layer->data.type != XRT_LAYER_PROJECTION_DEPTH) ||
+	    layer->data.view_count != data->view_count) {
+		return XRT_ERROR_INVALID_ARGUMENT;
+	}
+
+	for (uint32_t i = 0; i < data->view_count; ++i) {
+		xrt_swapchain_reference(&layer->xscs[2 * XRT_MAX_VIEWS + i], mv_xsc[i]);
+		xrt_swapchain_reference(&layer->xscs[3 * XRT_MAX_VIEWS + i], d_xsc[i]);
+	}
+	layer->fs = *data;
+	layer->has_frame_synthesis = true;
+
+	return XRT_SUCCESS;
+}
+
 static xrt_result_t
 multi_compositor_layer_quad(struct xrt_compositor *xc,
                             struct xrt_device *xdev,
@@ -1010,6 +1038,7 @@ multi_compositor_create(struct multi_system_compositor *msc,
 	mc->base.base.layer_begin = multi_compositor_layer_begin;
 	mc->base.base.layer_projection = multi_compositor_layer_projection;
 	mc->base.base.layer_projection_depth = multi_compositor_layer_projection_depth;
+	mc->base.base.layer_frame_synthesis = multi_compositor_layer_frame_synthesis;
 	mc->base.base.layer_quad = multi_compositor_layer_quad;
 	mc->base.base.layer_cube = multi_compositor_layer_cube;
 	mc->base.base.layer_cylinder = multi_compositor_layer_cylinder;
diff --git a/src/xrt/compositor/multi/comp_multi_private.h b/src/xrt/compositor/multi/comp_multi_private.h
index 34e48e4ff..69c27f488 100644
--- a/src/xrt/compositor/multi/comp_multi_private.h
+++ b/src/xrt/compositor/multi/comp_multi_private.h
@@ -67,15 +67,24 @@ struct multi_layer_entry
 	/*!
 	 * Pointers to swapchains.
 	 *
-	 * How many are actually used depends on the value of @p data.type
+	 * How many are actually used depends on the value of @p data.type,
+	 * frame synthesis swapchains are at offset 2 * XRT_MAX_VIEWS (motion
+	 * vectors) and 3 * XRT_MAX_VIEWS (depth) when @p has_frame_synthesis
+	 * is set.
 	 */
-	struct xrt_swapchain *xscs[2 * XRT_MAX_VIEWS];
+	struct xrt_swapchain *xscs[4 * XRT_MAX_VIEWS];
 
 	/*!
 	 * All basic (trivially-serializable) data associated with a layer,
 	 * aside from which swapchain(s) are used.
 	 */
 	struct xrt_layer_data data;
+
+	//! Whether @p fs is valid, only for projection layers.
+	bool has_frame_synthesis;
+
+	//! Frame synthesis data (XR_EXT_frame_synthesis).
+	struct xrt_layer_frame_synthesis_data fs;
 };
 
 /*!
diff --git a/src/xrt/compositor/multi/comp_multi_system.c b/src/xrt/compositor/multi/comp_multi_system.c
index 325581f61..9aff22722 100644
--- a/src/xrt/compositor/multi/comp_multi_system.c
+++ b/src/xrt/compositor/multi/comp_multi_system.c
@@ -50,6 +50,30 @@
  *
  */
 
+static void
+do_frame_synthesis(struct xrt_compositor *xc, struct multi_layer_entry *layer, uint32_t i)
+{
+	if (!layer->has_frame_synthesis) {
+		return;
+	}
+
+	struct xrt_swapchain *mv_xsc[XRT_MAX_VIEWS];
+	struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS];
+
+	for (uint32_t j = 0; j < layer->fs.view_count; j++) {
+		mv_xsc[j] = layer->xscs[2 * XRT_MAX_VIEWS + j];
+		d_xsc[j] = layer->xscs[3 * XRT_MAX_VIEWS + j];
+
+		if (mv_xsc[j] == NULL || d_xsc[j] == NULL) {
+			U_LOG_E("Invalid frame synthesis swap chain for projection layer #%u!", i);
+			return;
+		}
+	}
+
+	// Optional for the native compositor, ignore XRT_ERROR_NOT_IMPLEMENTED.
+	xrt_comp_layer_frame_synthesis(xc, mv_xsc, d_xsc, &layer->fs);
+}
+
 static void
 do_projection_layer(struct xrt_compositor *xc, struct multi_compositor *mc, struct multi_layer_entry *layer, uint32_t i)
 {
@@ -71,7 +95,9 @@ do_projection_layer(struct xrt_compositor *xc, struct multi_compositor *mc, stru
 		return;
 	}
 
-	xrt_comp_layer_projection(xc, xdev, layer->xscs, data);
+	if (xrt_comp_layer_projection(xc, xdev, layer->xscs, data) == XRT_SUCCESS) {
+		do_frame_synthesis(xc, layer, i);
+	}
 }
 
 static void
@@ -103,7 +129,9 @@ do_projection_layer_depth(struct xrt_compositor *xc,
 	}
 
 
-	xrt_comp_layer_projection_depth(xc, xdev, xsc, d_xsc, data);
+	if (xrt_comp_layer_projection_depth(xc, xdev, xsc, d_xsc, data) == XRT_SUCCESS) {
+		do_frame_synthesis(xc, layer, i);
+	}
 }
 
 static bool
diff --git a/src/xrt/compositor/util/comp_base.c b/src/xrt/compositor/util/comp_base.c
index fa3428be9..82a66b089 100644
--- a/src/xrt/compositor/util/comp_base.c
+++ b/src/xrt/compositor/util/comp_base.c
@@ -120,6 +120,16 @@ base_layer_projection_depth(struct xrt_compositor *xc,
 	return comp_layer_accum_projection_depth(&cb->layer_accum, xsc, d_xsc, data);
 }
 
+static xrt_result_t
+base_layer_frame_synthesis(struct xrt_compositor *xc,
+                           struct xrt_swapchain *mv_xsc[XRT_MAX_VIEWS],
+                           struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS],
+                           const struct xrt_layer_frame_synthesis_data *data)
+{
+	struct comp_base *cb = comp_base(xc);
+	return comp_layer_accum_frame_synthesis(&cb->layer_accum, mv_xsc, d_xsc, data);
+}
+
 static xrt_result_t
 base_layer_quad(struct xrt_compositor *xc,
                 struct xrt_device *xdev,
@@ -224,6 +234,7 @@ comp_base_init(struct comp_base *cb)
 	iface->layer_begin = base_layer_begin;
 	iface->layer_projection = base_layer_projection;
 	iface->layer_projection_depth = base_layer_projection_depth;
+	iface->layer_frame_synthesis = base_layer_frame_synthesis;
 	iface->layer_quad = base_layer_quad;
 	iface->layer_cube = base_layer_cube;
 	iface->layer_cylinder = base_layer_cylinder;
diff --git a/src/xrt/compositor/util/comp_layer_accum.c b/src/xrt/compositor/util/comp_layer_accum.c
index 7314daff8..c4b065515 100644
--- a/src/xrt/compositor/util/comp_layer_accum.c
+++ b/src/xrt/compositor/util/comp_layer_accum.c
@@ -25,6 +25,7 @@ push_single_swapchain_layer(struct comp_layer_accum *cla, struct xrt_swapchain *
 	U_ZERO_ARRAY(layer->sc_array);
 	layer->sc_array[0] = xsc;
 	layer->data = *data;
+	layer->has_frame_synthesis = false;
 
 	cla->layer_count++;
 
@@ -46,6 +47,20 @@ comp_layer_get_depth_swapchain(const struct comp_layer *cl, uint32_t swapchain_i
 	return cl->sc_array[XRT_MAX_VIEWS + swapchain_index];
 }
 
+struct xrt_swapchain *
+comp_layer_get_frame_synthesis_motion_vector_swapchain(const struct comp_layer *cl, uint32_t swapchain_index)
+{
+	assert(cl->has_frame_synthesis);
+	return cl->sc_array[2 * XRT_MAX_VIEWS + swapchain_index];
+}
+
+struct xrt_swapchain *
+comp_layer_get_frame_synthesis_depth_swapchain(const struct comp_layer *cl, uint32_t swapchain_index)
+{
+	assert(cl->has_frame_synthesis);
+	return cl->sc_array[3 * XRT_MAX_VIEWS + swapchain_index];
+}
+
 xrt_result_t
 comp_layer_accum_begin(struct comp_layer_accum *cla, const struct xrt_layer_frame_data *data)
 {
@@ -70,6 +85,7 @@ comp_layer_accum_projection(struct comp_layer_accum *cla,
 		layer->sc_array[i] = xsc[i];
 	}
 	layer->data = *data;
+	layer->has_frame_synthesis = false;
 
 	cla->layer_count++;
 
@@ -92,12 +108,39 @@ comp_layer_accum_projection_depth(struct comp_layer_accum *cla,
 		layer->sc_array[XRT_MAX_VIEWS + i] = d_xsc[i];
 	}
 	layer->data = *data;
+	layer->has_frame_synthesis = false;
 
 	cla->layer_count++;
 
 	return XRT_SUCCESS;
 }
 
+xrt_result_t
+comp_layer_accum_frame_synthesis(struct comp_layer_accum *cla,
+                                 struct xrt_swapchain *mv_xsc[XRT_MAX_VIEWS],
+                                 struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS],
+                                 const struct xrt_layer_frame_synthesis_data *data)
+{
+	if (cla->layer_count == 0) {
+		return XRT_ERROR_INVALID_ARGUMENT;
+	}
+
+	struct comp_layer *layer = &cla->layers[cla->layer_count - 1];
+	if ((layer->data.type != XRT_LAYER_PROJECTION && layer->data.type != XRT_LAYER_PROJECTION_DEPTH) ||
+	    data->view_count != layer->data.view_count || data->view_count > XRT_MAX_VIEWS) {
+		return XRT_ERROR_INVALID_ARGUMENT;
+	}
+
+	for (uint32_t i = 0; i < data->view_count; ++i) {
+		layer->sc_array[2 * XRT_MAX_VIEWS + i] = mv_xsc[i];
+		layer->sc_array[3 * XRT_MAX_VIEWS + i] = d_xsc[i];
+	}
+	layer->fs = *data;
+	layer->has_frame_synthesis = true;
+
+	return XRT_SUCCESS;
+}
+
 xrt_result_t
 comp_layer_accum_quad(struct comp_layer_accum *cla, struct xrt_swapchain *xsc, const struct xrt_layer_data *data)
 {
diff --git a/src/xrt/compositor/util/comp_layer_accum.h b/src/xrt/compositor/util/comp_layer_accum.h
index 58ac8e2cb..79e7db853 100644
--- a/src/xrt/compositor/util/comp_layer_accum.h
+++ b/src/xrt/compositor/util/comp_layer_accum.h
@@ -35,16 +35,26 @@ struct xrt_swapchain;
 struct comp_layer
 {
 	/*!
-	 * Up to two compositor swapchains referenced per view (color and depth) for a layer.
+	 * Up to four compositor swapchains referenced per view for a layer:
+	 * color, depth, frame synthesis motion vectors, frame synthesis depth.
 	 *
 	 * Unused elements should be set to null.
 	 */
-	struct xrt_swapchain *sc_array[XRT_MAX_VIEWS * 2];
+	struct xrt_swapchain *sc_array[XRT_MAX_VIEWS * 4];
 
 	/*!
 	 * All basic (trivially-serializable) data associated with a layer.
 	 */
 	struct xrt_layer_data data;
+
+	//! Whether @ref fs and the frame synthesis swapchains are valid.
+	bool has_frame_synthesis;
+
+	/*!
+	 * Frame synthesis data, only valid for projection layers when
+	 * @ref has_frame_synthesis is set.
+	 */
+	struct xrt_layer_frame_synthesis_data fs;
 };
 
 
@@ -71,6 +81,28 @@ comp_layer_get_swapchain(const struct comp_layer *cl, uint32_t swapchain_index);
 struct xrt_swapchain *
 comp_layer_get_depth_swapchain(const struct comp_layer *cl, uint32_t swapchain_index);
 
+/*!
+ * Get a frame synthesis motion vector swapchain associated with a projection layer
+ *
+ * @param cl self
+ * @param swapchain_index index of **color** swapchain - typically this is the view index.
+ *
+ * @public @memberof comp_layer
+ */
+struct xrt_swapchain *
+comp_layer_get_frame_synthesis_motion_vector_swapchain(const struct comp_layer *cl, uint32_t swapchain_index);
+
+/*!
+ * Get a frame synthesis depth swapchain associated with a projection layer
+ *
+ * @param cl self
+ * @param swapchain_index index of **color** swapchain - typically this is the view index.
+ *
+ * @public @memberof comp_layer
+ */
+struct xrt_swapchain *
+comp_layer_get_frame_synthesis_depth_swapchain(const struct comp_layer *cl, uint32_t swapchain_index);
+
 
 
 /*!
@@ -126,6 +158,18 @@ comp_layer_accum_projection_depth(struct comp_layer_accum *cla,
                                   struct xrt_swapchain *xsc[XRT_MAX_VIEWS],
                                   struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS],
                                   const struct xrt_layer_data *data);
+/*!
+ * Attach frame synthesis swapchains and data to the last accumulated layer,
+ * which must be a projection layer.
+ *
+ * @public @memberof comp_layer_accum
+ */
+xrt_result_t
+comp_layer_accum_frame_synthesis(struct comp_layer_accum *cla,
+                                 struct xrt_swapchain *mv_xsc[XRT_MAX_VIEWS],
+                                 struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS],
+                                 const struct xrt_layer_frame_synthesis_data *data);
+
 /*!
  * Accumulate swapchain and data for a quad layer for a frame.
  *
diff --git a/src/xrt/include/xrt/xrt_compositor.h b/src/xrt/include/xrt/xrt_compositor.h
index 3d8242540..a30adb212 100644
--- a/src/xrt/include/xrt/xrt_compositor.h
+++ b/src/xrt/include/xrt/xrt_compositor.h
@@ -431,6 +431,71 @@ struct xrt_layer_passthrough_data
 	struct xrt_passthrough_layer xrt_pl;
 };
 
+/*!
+ * Flags for frame synthesis data, values match XrFrameSynthesisInfoFlagsEXT.
+ */
+enum xrt_frame_synthesis_flags
+{
+	//! The motion vector image contains 2D (rg) motion instead of 3D (rgb).
+	XRT_FRAME_SYNTHESIS_USE_2D_MOTION_VECTOR_BIT = 1u << 0u,
+	//! The application prefers additional time to render each frame.
+	XRT_FRAME_SYNTHESIS_REQUEST_RELAXED_FRAME_INTERVAL_BIT = 1u << 1u,
+};
+
+/*!
+ * Frame synthesis data (XR_EXT_frame_synthesis) for one view of a projection
+ * layer.
+ *
+ * The motion vector is defined as
+ * `image.rgb * motion_vector_scale + motion_vector_offset`, expressed as the
+ * difference of the current and previous Vulkan-style NDC positions
+ * ([-1,-1,0] to [1,1,1]). The w components of the OpenXR scale and offset are
+ * ignored by the specification and are not stored.
+ *
+ * The @ref xrt_swapchain references are provided outside of this struct.
+ */
+struct xrt_layer_frame_synthesis_view_data
+{
+	//! Bitmask of @ref xrt_frame_synthesis_flags.
+	uint64_t flags;
+
+	struct xrt_sub_image motion_vector_sub;
+	struct xrt_vec3 motion_vector_scale;
+	struct xrt_vec3 motion_vector_offset;
+
+	/*!
+	 * XrFrameSynthesisInfoEXT::appSpaceDeltaPose, unmodified: expressed in
+	 * the space of the projection layer.
+	 */
+	struct xrt_pose app_space_delta_pose;
+
+	/*!
+	 * Pose of the projection layer space in the same space as the view
+	 * poses of the projection layer (@ref xrt_layer_projection_view_data::pose)
+	 * at the time of the frame, so that @ref app_space_delta_pose can be
+	 * converted by the compositor.
+	 */
+	struct xrt_pose layer_space_pose;
+
+	struct xrt_sub_image depth_sub;
+	float min_depth;
+	float max_depth;
+	//! May be infinite, may be greater than far_z for reversed depth.
+	float near_z;
+	//! May be infinite.
+	float far_z;
+};
+
+/*!
+ * Frame synthesis data (XR_EXT_frame_synthesis) attached to a projection
+ * layer, see @ref xrt_compositor::layer_frame_synthesis.
+ */
+struct xrt_layer_frame_synthesis_data
+{
+	uint32_t view_count;
+	struct xrt_layer_frame_synthesis_view_data v[XRT_MAX_VIEWS];
+};
+
 /*!
  * All the pure data values associated with a composition layer.
  *
@@ -1395,6 +1460,23 @@ struct xrt_compositor
 	                                  struct xrt_device *xdev,
 	                                  const struct xrt_layer_data *data);
 
+	/*!
+	 * Attaches frame synthesis data (XR_EXT_frame_synthesis) to the
+	 * projection layer that was submitted last, by @ref layer_projection
